<?xml version="1.0" encoding="utf-8"?>
<!-- Dot Hue (widget_hue_empty before the first draw): the card, the art bitmap from HueArt (One UI ignores widget
     fonts, so all text is drawn into it) and, over it, up to 4 rows of transparent tap cells that HueWidget sizes
     and places at runtime from HueLayout: a name cell (toggle) and five 32 dp dot cells (HueLayout.DOT_CELL_DP,
     brightness 20..100%). No plain View: not allowed in RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hue_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/card_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/hue_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_hue_desc" />
    <LinearLayout
        android:id="@+id/hue_row_0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/hue_r0_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/hue_r0_d0"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r0_d1"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r0_d2"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r0_d3"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r0_d4"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hue_row_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/hue_r1_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/hue_r1_d0"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r1_d1"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r1_d2"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r1_d3"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r1_d4"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hue_row_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/hue_r2_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/hue_r2_d0"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r2_d1"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r2_d2"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r2_d3"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r2_d4"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hue_row_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/hue_r3_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/hue_r3_d0"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r3_d1"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r3_d2"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r3_d3"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/hue_r3_d4"
            android:layout_width="32dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</FrameLayout>
