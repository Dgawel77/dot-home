<?xml version="1.0" encoding="utf-8"?>
<!-- The music widget while something plays (widget_music_empty otherwise): the card, art and text bitmap, and
     three 56 dp transport buttons with 32 dp glyphs. 56 dp fits the 1-row height (95 dp less 2 x 16 dp pad
     leaves 63 dp); WidgetArt.music keeps MUSIC_TRANSPORT_DP clear for them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/music_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitStart"
        android:contentDescription="@string/widget_music_desc" />
    <!-- the album art's touch target: the 16 dp inset plus the 64 dp art square, the full widget height -->
    <FrameLayout
        android:id="@+id/music_art_tap"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:contentDescription="@string/music_open_player" />
    <!-- 20 transparent seek zones over the progress dot row; WidgetUpdater sizes and positions this row at runtime
         (no plain View: not allowed in RemoteViews) and only attaches click intents when the session can seek. -->
    <LinearLayout
        android:id="@+id/music_seek"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/music_seek_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_11"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_13"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_17"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_18"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/music_seek_19"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/music_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_prev"
            android:contentDescription="@string/music_prev" />
        <ImageButton
            android:id="@+id/music_play"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/music_play_pause" />
        <ImageButton
            android:id="@+id/music_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_next"
            android:contentDescription="@string/music_next" />
    </LinearLayout>
</FrameLayout>
