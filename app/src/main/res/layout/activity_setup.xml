<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Dot Home"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/step_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btn_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grant location" />

        <TextView
            android:id="@+id/step_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open the app's permission settings, tap Location, then choose &quot;Allow all the time&quot; so the weather stays fresh."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open app settings" />

        <TextView
            android:id="@+id/step_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lets the music widget show what is playing."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open notification access" />

        <TextView
            android:id="@+id/step_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btn_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set wallpaper" />

        <TextView
            android:id="@+id/step_fire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <RadioGroup
            android:id="@+id/fire_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Rock style"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dots on grid draws rocks as filled shapes on the 4 dp lattice. Outline keeps the free outline dots, to compare shimmer."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <RadioGroup
            android:id="@+id/rock_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Blue Line"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/cta_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Dot Blue Line widget needs a free CTA Train Tracker API key. It shows the pinned station, or the nearest one within 10 km."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/cta_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CTA Train Tracker key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />
        <Button
            android:id="@+id/btn_cta_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save key" />
        <Spinner
            android:id="@+id/cta_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Export lock stills" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Weather data by Open-Meteo.com · Alerts: National Weather Service"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
